{
  "command": "deno task test",
  "ran": "\\d+ passed",
  "mutations": [
    {
      "name": "attribution is no longer required",
      "file": "publish/snapshotPublish.ts",
      "find": "  if (!desc.attribution || !/[\\p{L}\\p{N}]/u.test(desc.attribution.replace(/\\p{Cf}/gu, ''))) {",
      "replace": "  if (false) {"
    },
    {
      "name": "a derivative database need not carry a share-alike licence",
      "file": "publish/snapshotPublish.ts",
      "find": "    if (!isDatabaseCopyleft(desc.spdx)) {",
      "replace": "    if (false) {"
    },
    {
      "name": "the licence URL need not travel with the data",
      "file": "publish/snapshotPublish.ts",
      "find": "    if (!desc.licenceUrl || desc.licenceUrl.trim() === '') {",
      "replace": "    if (false) {"
    },
    {
      "name": "the ODbL 4.6 data-availability notice is no longer required",
      "file": "publish/snapshotPublish.ts",
      "find": "    if (!desc.dataAvailabilityNotice || desc.dataAvailabilityNotice.trim() === '') {",
      "replace": "    if (false) {"
    },
    {
      "name": "an aggregate may claim a share-alike licence",
      "file": "publish/snapshotPublish.ts",
      "find": "  if (isDatabaseCopyleft(desc.spdx)) {",
      "replace": "  if (false) {"
    },
    {
      "name": "an aggregate may carry a data-availability notice",
      "file": "publish/snapshotPublish.ts",
      "find": "  if (desc.dataAvailabilityNotice) {",
      "replace": "  if (false) {"
    },
    {
      "name": "immutable artifacts cached for a minute instead of a year",
      "file": "publish/snapshotPublish.ts",
      "find": "'Cache-Control': 'public, max-age=31536000, immutable',",
      "replace": "'Cache-Control': 'public, max-age=60, immutable',"
    },
    {
      "name": "the MUTABLE pointer cached for a year",
      "file": "publish/snapshotPublish.ts",
      "find": "'Cache-Control': 'public, max-age=60, must-revalidate',",
      "replace": "'Cache-Control': 'public, max-age=31536000, must-revalidate',"
    },
    {
      "name": "SPDX normalisation removed \u2014 spelling becomes policy",
      "file": "publish/snapshotPublish.ts",
      "find": "  return spdx.trim().toUpperCase().replace(/(-OR-LATER|\\+)$/, '');",
      "replace": "  return spdx;"
    },
    {
      "name": "the ODC- prefix is no longer recognised",
      "file": "publish/snapshotPublish.ts",
      "find": "  return DATABASE_COPYLEFT_SPDX.has(id) || DATABASE_COPYLEFT_SPDX.has(id.replace(/^ODC-/, ''));",
      "replace": "  return DATABASE_COPYLEFT_SPDX.has(id);"
    },
    {
      "name": "a class outside the union falls through to aggregate again",
      "file": "publish/snapshotPublish.ts",
      "find": "  if (desc.class !== 'aggregate_statistics' && desc.class !== 'derivative_database') {",
      "replace": "  if (false) {"
    },
    {
      "name": "an empty SPDX id is accepted",
      "file": "publish/snapshotPublish.ts",
      "find": "  if (!desc.spdx || normaliseSpdx(desc.spdx) === '') {",
      "replace": "  if (false) {"
    },
    {
      "name": "a whitespace-only licence URL satisfies ODbL again",
      "file": "publish/snapshotPublish.ts",
      "find": "    if (!desc.licenceUrl || desc.licenceUrl.trim() === '') {",
      "replace": "    if (!desc.licenceUrl) {"
    },
    {
      "name": "the PWT coordinate clamp is removed",
      "file": "feeds/worship/worship.ts",
      "find": "const clamp = (v: number) => (v < 0 ? 0 : v > 65535 ? 65535 : Math.round(v));",
      "replace": "const clamp = (v: number) => Math.round(v);"
    },
    {
      "name": "attribution check stops seeing invisible characters",
      "file": "publish/snapshotPublish.ts",
      "find": "!/[\\p{L}\\p{N}]/u.test(desc.attribution.replace(/\\p{Cf}/gu, ''))",
      "replace": "desc.attribution.trim() === ''"
    },
    {
      "name": "CC-BY-SA-2.0 dropped from the copyleft set — an aggregate may claim it again",
      "file": "publish/snapshotPublish.ts",
      "find": "  'CC-BY-SA-2.0',\n",
      "replace": ""
    },
    {
      "name": "a finite out-of-range USGS timestamp is no longer bounded, crashing the batch",
      "file": "feeds/usgs/usgs.ts",
      "find": " || Math.abs(props.time) > MAX_EPOCH_MS",
      "replace": ""
    }
  ]
}
